# ──────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
# ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ──────────────────────────────────────
# NEXTAUTH
# NEXTAUTH_URL: your app's URL (http://localhost:3000 for dev)
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate
# ──────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ──────────────────────────────────────
# GOOGLE OAUTH (for web dashboard login)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Redirect URI: http://localhost:3000/api/auth/callback/google
# ──────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────
# EXTENSION JWT SECRET
# Used to sign JWTs for the Chrome Extension auth flow
# Run `openssl rand -base64 32` to generate
# ──────────────────────────────────────
JWT_SECRET=""

# ──────────────────────────────────────
# OPENAI (Phase 2)
# Get from: https://platform.openai.com/api-keys
# ──────────────────────────────────────
OPENAI_API_KEY=""

# ──────────────────────────────────────
# STRIPE (Phase 4)
# Get from: https://dashboard.stripe.com/apikeys
# Webhook secret: Stripe Dashboard → Developers → Webhooks → Signing secret
# Price ID: Create a product in Stripe → copy the price ID (price_xxx)
# ──────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# ──────────────────────────────────────
# APP URL (used for redirects, CORS, emails)
# ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
