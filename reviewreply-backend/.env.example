# ──────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
# ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ──────────────────────────────────────
# NEXTAUTH
# NEXTAUTH_URL: your app's URL (http://localhost:3000 for dev)
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate
# ──────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ──────────────────────────────────────
# GOOGLE OAUTH (for web dashboard login)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Redirect URI: http://localhost:3000/api/auth/callback/google
# ──────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────
# EXTENSION JWT SECRET
# Used to sign JWTs for the Chrome Extension auth flow
# Run `openssl rand -base64 32` to generate
# ──────────────────────────────────────
JWT_SECRET=""

# ──────────────────────────────────────
# GROQ AI (Phase 2)
# Get from: https://console.groq.com/keys
# ──────────────────────────────────────
GROQ_API_KEY=""

# ──────────────────────────────────────
# LEMONSQUEEZY (Phase 4 — Billing)
# 1. Create account at https://lemonsqueezy.com
# 2. Create a Store and a Product (subscription, e.g. $9.99/mo)
# 3. Get API key from: Settings → API
# 4. Store ID from: Settings → Stores
# 5. Variant ID from: your product's variant page URL
# 6. Webhook secret: Webhooks → create webhook → copy signing secret
# ──────────────────────────────────────
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_PRO_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# ──────────────────────────────────────
# APP URL (used for redirects, CORS, emails)
# ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
