{
  "manifest_version": 3,
  "name": "ReviewReply AI",
  "version": "1.0.0",
  "description": "AI-powered review replies, injected directly into Google Business Profile.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://business.google.com/*",
    "http://localhost:5555/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.google.com/*",
        "http://localhost:5555/*"
      ],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
